# Everything here is optional. CampusCart runs with no .env file at all.
# To use a setting, copy this file to .env and remove the # in front of it.

# Port for the app and API.
# PORT=5000

# Use your own database, such as a MongoDB Atlas cluster.
# MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/campuscart

# Set to "memory" for a throwaway database that is erased on exit.
# DB_MODE=memory

# Where the embedded database keeps its files.
# CAMPUSCART_DATA_DIR=C:\CampusCartData

# Secret used to sign login tokens.
# JWT_SECRET=change-me
